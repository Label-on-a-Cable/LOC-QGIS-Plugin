# Ignore everything by default
*

# Include this file
!.gitignore

# Include the plugin folder
!label_on_a_cable/
!label_on_a_cable/**

# Include unit tests (plain Python, no QGIS required)
!tests/
!tests/**

# Exclude generated/temporary files within the plugin
__pycache__/
*.pyc
*.pyo

# Release build artifact
label_on_a_cable.zip
*.zip
